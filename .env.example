# App
APP_NAME="Apex Quiz API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (use PostgreSQL in production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/apex_quiz
DATABASE_URL=sqlite+aiosqlite:///./apex_quiz.db

# Subscription Tiers
FREE_QUESTION_MAX=10
FREE_QUESTION_MIN=5
PREMIUM_QUESTION_MAX=50
PREMIUM_QUESTION_MIN=10

# PDF Processing
PDF_MAX_MB=20
STRUCTURE_QUALITY_THRESHOLD=0.6

# Gemini AI (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT=25
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY=1.5
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=8192

# Study Aid Generation (grounded flashcards + quizzes)
STUDY_AID_CHUNK_SIZE=12000
STUDY_AID_CHUNK_OVERLAP=400
STUDY_AID_MAX_CHUNKS=8
STUDY_AID_CONCURRENCY=3
STUDY_AID_MAX_OUTPUT_TOKENS=8192
STUDY_AID_GROUNDING_MIN_CHARS=8

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5175","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5175"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO

# Firebase (get from Firebase Console > Project Settings > General > Your apps > Web app)
# VITE_FIREBASE_API_KEY=your_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id