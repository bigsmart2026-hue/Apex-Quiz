rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Question banks (read-only) ----------
    match /quizzes/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- Cached questions ----------
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.categoryId is string
        && request.resource.data.text is string
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 6
        && request.resource.data.correctAnswer is number
        && request.resource.data.correctAnswer >= 0
        && request.resource.data.correctAnswer < request.resource.data.options.size()
        && request.resource.data.difficulty in ['easy', 'medium', 'hard', 'master']
        && request.resource.data.active == true;
      allow update, delete: if false;
    }

    // ---------- User profiles ----------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
        && request.resource.data.xp == 0
        && request.resource.data.unlockedLevel == 1
        && request.resource.data.currentStreak == 0
        && request.resource.data.quizzesCompleted == 0;
      allow update: if request.auth.uid == userId
        // Type checks for critical gamification fields
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 1000000
        && request.resource.data.unlockedLevel is number
        && request.resource.data.unlockedLevel >= 1
        && request.resource.data.unlockedLevel <= 4
        && request.resource.data.currentStreak is number
        && request.resource.data.currentStreak >= 0
        && request.resource.data.currentStreak <= 365
        && request.resource.data.longestStreak is number
        && request.resource.data.longestStreak >= 0
        && request.resource.data.longestStreak <= 365
        && request.resource.data.quizzesCompleted is number
        && request.resource.data.quizzesCompleted >= 0
        && request.resource.data.questionsAnswered is number
        && request.resource.data.questionsAnswered >= 0
        && request.resource.data.correctAnswers is number
        && request.resource.data.correctAnswers >= 0
        && request.resource.data.weeklyXp is number
        && request.resource.data.weeklyXp >= 0
        && (request.resource.data.lastPlayedDate == null
            || request.resource.data.lastPlayedDate is string)
        && (request.resource.data.weekStart == null
            || request.resource.data.weekStart is string)
        && request.resource.data.achievements is map
        && request.resource.data.categoryStats is map;
      allow delete: if false;

      // ---------- Notifications ----------
      match /notifications/{notifId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.type in ['challenge', 'challenge-created']
          && request.resource.data.read == false;
        allow update: if request.auth.uid == userId
          && request.resource.data.read == true
          && resource.data.read == false;
        allow delete: if false;
      }

      // ---------- Category progress ----------
      match /categoryProgress/{categoryId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId
          && request.resource.data.currentLevel == 1
          && request.resource.data.highestLevel == 1
          && request.resource.data.totalQuestions >= 0
          && request.resource.data.totalQuestions <= 10000
          && request.resource.data.correctAnswers >= 0
          && request.resource.data.correctAnswers <= request.resource.data.totalQuestions
          && request.resource.data.incorrectAnswers >= 0
          && request.resource.data.incorrectAnswers <= request.resource.data.totalQuestions
          && request.resource.data.totalPoints >= 0
          && request.resource.data.totalPoints <= 500000
          && request.resource.data.quizzesCompleted == 0
          && request.resource.data.masteryPercentage >= 0
          && request.resource.data.masteryPercentage <= 100
          && request.resource.data.levelsUnlocked is map
          && request.resource.data.levelsUnlocked["1"] == true;
        allow update: if request.auth.uid == userId
          // Level can only increase by at most 1, max 4
          && request.resource.data.currentLevel >= resource.data.currentLevel
          && request.resource.data.currentLevel <= resource.data.currentLevel + 1
          && request.resource.data.currentLevel <= 4
          // Highest level can only increase
          && request.resource.data.highestLevel >= resource.data.highestLevel
          && request.resource.data.highestLevel <= 4
          // Total questions can only increase (quiz has 5-20 questions)
          && request.resource.data.totalQuestions >= resource.data.totalQuestions
          && request.resource.data.totalQuestions <= resource.data.totalQuestions + 20
          // Correct answers can only increase
          && request.resource.data.correctAnswers >= resource.data.correctAnswers
          && request.resource.data.correctAnswers <= resource.data.correctAnswers + 20
          && request.resource.data.correctAnswers <= request.resource.data.totalQuestions
          // Incorrect answers can only increase
          && request.resource.data.incorrectAnswers >= resource.data.incorrectAnswers
          && request.resource.data.incorrectAnswers <= resource.data.incorrectAnswers + 20
          && request.resource.data.incorrectAnswers <= request.resource.data.totalQuestions
          // Total points can only increase (max 50pts * 20 questions = 1000 per quiz)
          && request.resource.data.totalPoints >= resource.data.totalPoints
          && request.resource.data.totalPoints <= resource.data.totalPoints + 1000
          // Mastery percentage is bounded
          && request.resource.data.masteryPercentage >= 0
          && request.resource.data.masteryPercentage <= 100
          // Quizzes completed can only increase by 0 or 1
          && request.resource.data.quizzesCompleted >= resource.data.quizzesCompleted
          && request.resource.data.quizzesCompleted <= resource.data.quizzesCompleted + 1
          // Levels unlocked map can only grow
          && request.resource.data.levelsUnlocked is map
          // lastPlayedAt is always overwritten
          && request.resource.data.lastPlayedAt is timestamp;
        allow delete: if false;
      }
    }

    // ---------- Quiz attempts ----------
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.total >= 5
        && request.resource.data.total <= 20
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.accuracyPct >= 0
        && request.resource.data.accuracyPct <= 100
        && request.resource.data.categoryId is string;
      allow update, delete: if false;
    }

    // ---------- Daily challenge attempts ----------
    match /dailyChallengeAttempts/{attemptId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.total >= 5
        && request.resource.data.total <= 20
        && request.resource.data.score <= request.resource.data.total;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---------- Friend challenges ----------
    match /challenges/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.creatorId
        && request.resource.data.status in ['open', 'waiting']
        && request.resource.data.total >= 1
        && request.resource.data.total <= 20;
      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.total == resource.data.total
        && (
          // Opponent joins an open challenge
          (request.auth.uid == request.resource.data.opponentId
            && resource.data.status == 'open'
            && request.resource.data.status == 'active'
            && resource.data.opponentId == null)
          ||
          // Pre-assigned opponent joins a waiting challenge
          (request.auth.uid == request.resource.data.opponentId
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'active'
            && resource.data.opponentId == request.auth.uid)
          ||
          // Creator submits their score (once)
          (request.auth.uid == resource.data.creatorId
            && request.resource.data.creatorScore >= 0
            && request.resource.data.creatorScore <= resource.data.total
            && (resource.data.creatorScore == null
                || request.resource.data.creatorScore == resource.data.creatorScore))
          ||
          // Opponent submits their score (once)
          (request.auth.uid == resource.data.opponentId
            && request.resource.data.opponentScore >= 0
            && request.resource.data.opponentScore <= resource.data.total
            && (resource.data.opponentScore == null
                || request.resource.data.opponentScore == resource.data.opponentScore))
        );
      allow delete: if false;
    }
  }
}
