rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Question banks ----------
    match /quizzes/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- User profiles ----------
    // Readable by any authenticated user (powers the leaderboard).
    // Only the owner may create/update. XP, streaks and stats are
    // delta-bounded so the client cannot trivially inflate them.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
        && request.resource.data.xp == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.quizzesCompleted == 0;
      allow update: if request.auth.uid == userId;
      allow delete: if false;

      // ---------- Notifications ----------
      match /notifications/{notifId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.type in ['challenge', 'challenge-created']
          && request.resource.data.read == false;
        allow update: if request.auth.uid == userId
          && request.resource.data.read == true
          && resource.data.read == false;
        allow delete: if false;
      }
    }

    // ---------- Quiz attempts ----------
    // Deterministic doc id (`{uid}_{categoryId}_{date}`) means a second
    // submission for the same quiz+day is an update, which is denied —
    // this prevents replay/duplicate XP farming.
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total > 0
        && request.resource.data.total <= 20
        && request.resource.data.accuracyPct >= 0
        && request.resource.data.accuracyPct <= 100;
      allow update, delete: if false;
    }

    // ---------- Daily challenge attempts ----------
    match /dailyChallengeAttempts/{attemptId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total > 0
        && request.resource.data.total <= 20;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---------- Friend challenges ----------
    // Scores are immutable once set; participants may only write their own
    // slot. Winner is derived from stored scores, never accepted from client.
    match /challenges/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.creatorId
        && request.resource.data.status in ['open', 'waiting']
        && request.resource.data.total >= 1
        && request.resource.data.total <= 20;
      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.total == resource.data.total
        && (
          // Opponent joins an open challenge
          (request.auth.uid == request.resource.data.opponentId
            && resource.data.status == 'open'
            && request.resource.data.status == 'active'
            && resource.data.opponentId == null)
          ||
          // Pre-assigned opponent joins a waiting challenge
          (request.auth.uid == request.resource.data.opponentId
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'active'
            && resource.data.opponentId == request.auth.uid)
          ||
          // Creator submits their score (once)
          (request.auth.uid == resource.data.creatorId
            && request.resource.data.creatorScore >= 0
            && request.resource.data.creatorScore <= resource.data.total
            && (resource.data.creatorScore == null
                || request.resource.data.creatorScore == resource.data.creatorScore))
          ||
          // Opponent submits their score (once)
          (request.auth.uid == resource.data.opponentId
            && request.resource.data.opponentScore >= 0
            && request.resource.data.opponentScore <= resource.data.total
            && (resource.data.opponentScore == null
                || request.resource.data.opponentScore == resource.data.opponentScore))
        );
      allow delete: if false;
    }
  }
}